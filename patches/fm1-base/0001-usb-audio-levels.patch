     uint32_t t0 = fm1_ticks(), us, budget = HALF_FRAMES * 1000000u / FS;
@@ -44,8 +59,9 @@ static void render_block(int32_t *o)                /* ALNK0: one half, measured
     {
         uint32_t k, gain = APP_GAIN(master_pos);
 #if FELUCCA_UAC
-        const int full = uac_full != 0;             /* USB audio full: the render at full level for the USB audio
-                                                     * input, MASTER for the speaker after it (plat_usb_audio_full) */
+        const int full = uac_full != 0 || uac_set;  /* USB audio full: the render at full level for the USB audio
+                                                     * input, MASTER for the speaker after it (plat_usb_audio_full;
+                                                     * plat_usb_audio_set so too, the recording at its own level) */
 #else
         const int full = 0;
 #endif
@@ -63,18 +79,32 @@ static void render_block(int32_t *o)                /* ALNK0: one half, measured
             }
             if (radio_quiet)
                 continue;
+#if FELUCCA_UAC
+            if (uac_set && uac_rec_app)
+                rec_tap(o + 2u * k);                /* the recording: the app alone, before the computer's audio */
+#endif
 #if FELUCCA_UAC_OUT
-            uac_play(o + 2u * k, REND_FRAMES, full ? 4096u : master_pos * master_pos >> 12);   /* the computer's audio,
-                                                                                         * at MASTER */
+            uac_play(o + 2u * k, REND_FRAMES, uac_set ? uac_play_q12 : full ? 4096u : master_pos * master_pos >> 12);
+                                                    /* the computer's audio, at MASTER (or at its own level, MASTER
+                                                     * after it: plat_usb_audio_set) */
 #endif
 #if FELUCCA_UAC
-            uac_tap(o + 2u * k, REND_FRAMES);       /* the USB audio input: the same master output */
+            if (!uac_set)
+                uac_tap(o + 2u * k, REND_FRAMES);   /* the USB audio input: the same master output */
+            else if (!uac_rec_app)
+                rec_tap(o + 2u * k);                /* the recording: the mix, at its own level */
 #endif
             if (full) {                             /* the speaker and headphones: MASTER after the tap */
                 const float g = (float)gain * (1.0f / 4096.0f);
                 uint32_t i;
-                for (i = 0; i < 2u * REND_FRAMES; i++)
-                    o[2u * k + i] = (int32_t)((float)o[2u * k + i] * g);
+                if (uac_set)                        /* (a level past 100 % may take the mix past 24 bits) */
+                    for (i = 0; i < 2u * REND_FRAMES; i++) {
+                        const float v = (float)o[2u * k + i] * g;
+                        o[2u * k + i] = v > 8388607.0f ? 8388607 : v < -8388607.0f ? -8388607 : (int32_t)v;
+                    }
+                else
+                    for (i = 0; i < 2u * REND_FRAMES; i++)
+                        o[2u * k + i] = (int32_t)((float)o[2u * k + i] * g);
