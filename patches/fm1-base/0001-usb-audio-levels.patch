diff --git a/device/plat_fm1.c b/device/plat_fm1.c
index 48477b9..cc737e1 100644
--- a/device/plat_fm1.c
+++ b/device/plat_fm1.c
@@ -200,6 +200,21 @@ void plat_host_patience(uint32_t try_ms, uint32_t total_ms)
 /* USB audio full: the render at full level for the USB audio input, MASTER after it (main_fm1.c render_block) */
 static volatile uint8_t uac_full;
 void plat_usb_audio_full(int on) { uac_full = (uint8_t)(on != 0); }
+/* plat_usb_audio_set: the levels and the recording's source for render_block (main_fm1.c; MUTE is a level of 0),
+ * the streams presented for the USB descriptors (bsp chip/usb.c usb_audio_switch) */
+static volatile uint8_t uac_set, uac_rec_app;
+static volatile uint32_t uac_rec_q12 = 4096u, uac_play_q12 = 4096u;
+void plat_usb_audio_set(int rec, uint32_t rec_q12, int play, uint32_t play_q12, int from)
+{
+    uac_rec_q12 = rec == USB_AUDIO_ON ? (rec_q12 > 8192u ? 8192u : rec_q12) : 0u;
+    uac_play_q12 = play == USB_AUDIO_ON ? (play_q12 > 8192u ? 8192u : play_q12) : 0u;
+    uac_rec_app = (uint8_t)(from == USB_REC_APP);
+    RING_PUBLISH();
+    uac_set = 1;
+#if FELUCCA_UAC
+    usb_audio_switch((rec != USB_AUDIO_OFF ? 1u : 0u) | (play != USB_AUDIO_OFF ? 2u : 0u));
+#endif
+}
 void plat_yield(void)
 {
     ble_poll();                                   /* Bluetooth: its notifications go out while the screen draws */
diff --git a/host/plat_host.c b/host/plat_host.c
index 0edc269..6839a58 100644
--- a/host/plat_host.c
+++ b/host/plat_host.c
@@ -507,6 +507,20 @@ int plat_host_read(uint32_t addr, uint8_t *dst, uint32_t n) { (void)addr, (void)
 void plat_host_patience(uint32_t try_ms, uint32_t total_ms) { (void)try_ms, (void)total_ms; }
 static int uac_full;                            /* plat_usb_audio_full: the render at full level, MASTER after it */
 void plat_usb_audio_full(int on) { uac_full = on != 0; }
+/* plat_usb_audio_set: no USB audio here; the render as the FM-1 does it then (at full level, MASTER after), and what
+ * was asked kept for an app's checks (rec, rec_q12, play, play_q12, from; host_usb_audio_calls: how often) */
+static int32_t host_usb_audio[5] = {USB_AUDIO_ON, 4096, USB_AUDIO_ON, 4096, USB_REC_MIX};
+static uint32_t host_usb_audio_calls;
+void plat_usb_audio_set(int rec, uint32_t rec_q12, int play, uint32_t play_q12, int from)
+{
+    host_usb_audio[0] = rec;
+    host_usb_audio[1] = (int32_t)rec_q12;
+    host_usb_audio[2] = play;
+    host_usb_audio[3] = (int32_t)play_q12;
+    host_usb_audio[4] = from;
+    host_usb_audio_calls++;
+    uac_full = 1;
+}
 
 /* flash: one buffer per object, kept across a simulated reboot */
 static uint8_t store[OBJ_NOBJ][PLAT_STORE_MAX];
diff --git a/include/plat.h b/include/plat.h
index 68b7d21..13142d9 100644
--- a/include/plat.h
+++ b/include/plat.h
@@ -195,6 +195,18 @@ void plat_host_patience(uint32_t try_ms, uint32_t total_ms);   /* each try's wai
  * speaker and headphones only; 0, both at MASTER (the default) */
 void plat_usb_audio_full(int on);
 
+/* USB audio (FM1B_UAC), each direction on its own: the recording (the FM-1's sound, which the computer records) and
+ * the playback (the computer's sound through the FM-1, FM1B_UAC_OUT). Each USB_AUDIO_OFF: not presented to the
+ * computer at all (a change to or from OFF drops the FM-1 off USB for about a second, MIDI too, and the computer
+ * finds it again without that stream); USB_AUDIO_MUTE: presented, silent; USB_AUDIO_ON: at its level, Q12 (4096 =
+ * 100 %, up to 8192 = 200 %; the recording and the mix saturate). from: USB_REC_MIX, the recording has the playback
+ * in it (as the speaker has), USB_REC_APP, the app alone. Once an app calls it, the recording is at its own level and
+ * MASTER is the speaker's and the headphones' only (plat_usb_audio_full no longer counts). Call it in app_init with
+ * the saved setting, so the FM-1 comes up as it should (USB starts after app_init), and again when it changes. */
+enum { USB_AUDIO_OFF, USB_AUDIO_MUTE, USB_AUDIO_ON };
+enum { USB_REC_MIX, USB_REC_APP };
+void plat_usb_audio_set(int rec, uint32_t rec_q12, int play, uint32_t play_q12, int from);
+
 /* the keys' velocity and pressure (an app with APP_KEY_SENSE): on, the scan reads the keys on the analog rows and
  * hands each reading to the app (app_key_sample, app_key_probe); off by default */
 void plat_sense(int on);
