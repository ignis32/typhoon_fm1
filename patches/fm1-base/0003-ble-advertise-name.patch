+
+/* Advertise (a computer may find and connect to the FM-1) or not, as the player asks; off lets a connected computer
+ * go, and the central's link (BLE_MIDI_CENTRAL) stays. ready: the stack is up (else the wish waits for its start). */
+void ble_midi_advertise(int on, int ready)
+{
+    adv_wanted = (u8)(on != 0);
+    if (!ready)
+        return;
+    if (on) {
+        os_mutex_pend(&mutex, 0);
+        adv_ctrl_en = 1;
+        bt_ble_adv_enable(1);
+        os_mutex_post(&mutex);
+    } else
+        bt_ble_exit();
+}
