+
+#if FELUCCA_UAC
+/* Present the audio streams (without the console; with it, both as built): bit 0 the recording (the FM-1's output,
+ * EP4 IN), bit 1 the playback (the host's audio through the FM-1, EP4 OUT; with FELUCCA_UAC_OUT), 0 MIDI alone.
+ * Main loop: at boot before usb_start, or later from a setting. As usb_cdc_switch, a change while attached drops off
+ * the bus; usb_retry attaches again within a second with the other descriptors, and the host enumerates afresh. */
+static __attribute__((unused)) void usb_audio_switch(uint32_t streams)
+{
+    streams &= USB_AUD_ALL;
+    if (streams == usb_aud)
+        return;
+    if (usb.up && !USB_CDC_ON) {
+        usb.up = 0;                                     /* usb_poll (TIMER5) stops before the SIE goes */
+        RING_PUBLISH();
+        fm1_usb_off();
+        usb.config = 0;
+    }
+    uac_stream(0);                                      /* no stream until the host chooses one again */
+#if FELUCCA_UAC_OUT
+    uo_stream(0);
+#endif
+    usb_aud = (uint8_t)streams;
+}
+#endif
